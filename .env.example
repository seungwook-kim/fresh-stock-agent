# fresh-stock 설정 예시. 이 파일을 .env로 복사해서 값을 넣는다 (.env는 git에 올라가지 않는다).

# 저장소: SQLite 파일 경로(기본) 또는 PostgreSQL 주소 (Supabase: Project Settings > Database > Connection string)
FRESH_STOCK_DB=out/store.db
# FRESH_STOCK_DB=postgresql://postgres.<project>:<password>@<region>.pooler.supabase.com:5432/postgres

# LLM 백엔드: claude-code(기본, Claude Code 로그인 사용) 또는 anthropic(API)
FRESH_STOCK_LLM=claude-code
# ANTHROPIC_API_KEY=sk-ant-...

# 가게 위치 (날씨 예보용, 기본 서울). 지도에서 가게를 찾아 위도·경도를 넣는다
# FRESH_STOCK_LAT=37.57
# FRESH_STOCK_LON=126.98

# 로그인 (구글). Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > OAuth 클라이언트 ID (웹 애플리케이션)
# 승인된 리디렉션 URI: http://127.0.0.1:8799/auth/google (배포하면 https://도메인/auth/google)
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=...
# 세션 쿠키 서명 키 (아무 긴 무작위 문자열). 없으면 서버를 켤 때마다 새로 만들어져 다시 로그인해야 한다
# FRESH_STOCK_SECRET=...
# 개발용 로그인 (이메일만 입력). PC에서 확인할 때만 1로 둔다
# FRESH_STOCK_DEV_LOGIN=1
# https로 배포하면 1
# FRESH_STOCK_SECURE_COOKIES=1

# MCP 서버 (fresh-stock mcp): 이 이메일이 멤버인 가게만 다룬다
# FRESH_STOCK_EMAIL=boss@gmail.com

# fresh-stock 설정 예시. 이 파일을 .env로 복사해서 값을 넣는다 (.env는 git에 올라가지 않는다).

# 저장소: SQLite 파일 경로(기본) 또는 PostgreSQL 주소 (Supabase: Project Settings > Database > Connection string)
FRESH_STOCK_DB=out/store.db
# FRESH_STOCK_DB=postgresql://postgres.<project>:<password>@<region>.pooler.supabase.com:5432/postgres

# LLM 백엔드: claude-code(기본, Claude Code 로그인 사용) 또는 anthropic(API)
FRESH_STOCK_LLM=claude-code
# ANTHROPIC_API_KEY=sk-ant-...
